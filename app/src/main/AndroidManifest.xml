<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Только сеть: ACCESS_NETWORK_STATE не запрашиваем, пока ConnectivityManager не
         используется (наименьшие привилегии, ТЗ §7). Ф4 вернёт его вместе с офлайн-очередью. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- С Ф4: слушаем возвращение сети, чтобы очередь уходила сразу (ответ на Q4 в Ф0). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TaskmanApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Taskman"
        tools:ignore="UnusedAttribute">
        <!-- tools:ignore=UnusedAttribute — атрибуты back-callback и dataExtractionRules
             появились позже minSdk 26, но на старых API игнорируются штатно (ТЗ §5.2). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Taskman.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «Поделиться в Задачи» (ТЗ §5.3-Ф3: ACTION_SEND/SEND_MULTI intent-filter) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- FileProvider: отдаём внешним приложениям только скачанные вложения из кэша. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
